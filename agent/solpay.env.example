# Locked money-path configuration read by `solpay mcp-serve` without a shell.
#
# Copy to ~/.zeroclaw/solpay.env, keep mode 0600, and edit. The MCP server reads
# only known assignment keys. It does not evaluate command substitutions.
#
# Quote values with spaces. RPC URLs may contain provider credentials and must
# be protected. The merchant wallet is a PUBLIC receiving key; no signing key
# belongs in this file.

SOLANA_CLUSTER="devnet"                                   # devnet | mainnet-beta
ALLOW_MAINNET="false"                                     # hard interlock; "true" to permit mainnet
MERCHANT_WALLET="REPLACE_WITH_YOUR_PUBLIC_RECEIVING_KEY"  # base58 pubkey
SOLANA_RPC_PRIMARY="https://api.devnet.solana.com"
# SOLANA_RPC_FALLBACK="https://<your-fallback-rpc>"
# For Mainnet, configure separate provider URLs and set the explicit finalized
# commitment below. Keep these URLs secret if they contain API tokens.
# MAINNET_RPC_PRIMARY="https://<paid-mainnet-rpc>"
# MAINNET_RPC_FALLBACK="https://<independent-mainnet-rpc>"
TOKEN_ALLOWLIST="USDC,SOL"
ALLOW_TEST_MINT_OVERRIDE="false"
INVOICE_TTL_SECONDS="900"
# Required for the agent: create-url persists invoices; settle atomically claims payments.
INVOICE_DB="${HOME}/.zeroclaw/invoices.sqlite"
PAYMENT_COMMITMENT="confirmed"                            # never "processed"
# RPC_MIN_INTERVAL_MS="100"                                # Mainnet default
STORE_LABEL="ZeroClaw Store"
SIGNATURE_SCAN_LIMIT="500"                               # bounded 1..10000
