# Rust
/target
**/*.rs.bk

# Secrets & runtime state (NEVER commit)
.env
agent/data/*
!agent/data/.gitkeep
agent/logs/*
!agent/logs/.gitkeep
agent/data/tmp/

# Throwaway devnet keys used by E2E
tests/e2e/.keys/
*.devnet.json

# Commercial issuer/runtime material
*.sqlite
*.sqlite-*
*.key
*.tgz

# Cloudflare Worker local state
node_modules/

# OS / editor
.DS_Store
*.swp
__pycache__/
*.pyc
.wrangler/
