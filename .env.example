# ZeroClaw Solana Payment Assistant — configuration.
#
# Copy to `.env` and fill in. `.env` is git-ignored. Keep any provider token
# embedded in an RPC URL confidential. No customer private key is needed.
#
# ─────────────────────────────────────────────────────────────────────────────
# A) Read by the `solpay` binary today
# ─────────────────────────────────────────────────────────────────────────────

# Master switch. `devnet` (default) or `mainnet-beta`.
SOLANA_CLUSTER=devnet

# Safety interlock. Must be exactly `true` to run on mainnet-beta.
# With the default, solpay refuses to start on mainnet.
ALLOW_MAINNET=false

# The merchant's receiving wallet (base58, on-curve PUBLIC key — no private key).
# Deliberately blank: direct CLI use fails closed until you supply your own
# public receiving wallet. The demo scripts use a separate devnet fallback.
MERCHANT_WALLET=

# Shown in the customer's wallet and on the QR. Quote values that contain spaces.
STORE_LABEL="ZeroClaw Store"

# Comma-separated token symbols accepted. Supported: USDC (SPL) and SOL (native).
TOKEN_ALLOWLIST=USDC,SOL
# Keep false for real USDC. Only devnet test-token experiments may override mint.
ALLOW_TEST_MINT_OVERRIDE=false

# Charge bounds (decimal, in token units). Anti fat-finger / abuse.
MIN_CHARGE=0.01
MAX_CHARGE=1000

# Invoice validity window in seconds. Persist both timestamps from create-url.
INVOICE_TTL_SECONDS=900

# Uncomment for durable invoice issuance and atomic settlement. Use a private,
# persistent location and back it up. Without it, create-url is demo-only.
# INVOICE_DB=agent/data/invoices.sqlite

# Settlement bar: `confirmed` (devnet default) or `finalized`.
# Mainnet requires an explicit `PAYMENT_COMMITMENT=finalized`.
# `processed` is rejected. Confirmation times vary with cluster conditions.
PAYMENT_COMMITMENT=confirmed

# RPC endpoints. https required (http allowed only for localhost).
# The URL may embed a provider API key — treat the whole value as a secret.
SOLANA_RPC_PRIMARY=https://api.devnet.solana.com
SOLANA_RPC_FALLBACK=

# Separate Mainnet provider endpoints. Required for mainnet; do not put a
# provider API key in source control or use the public endpoint for capacity.
# MAINNET_RPC_PRIMARY=https://your-mainnet-rpc-provider.example/secret
# MAINNET_RPC_FALLBACK=https://your-independent-fallback.example/secret

# RPC resilience.
RPC_TIMEOUT_MS=8000
RPC_MAX_RETRIES=3
RPC_BACKOFF_BASE_MS=250
# Minimum time between this process's RPC requests (mainnet default: 100 ms).
# RPC_MIN_INTERVAL_MS=100
# SIGNATURE_SCAN_LIMIT=500

# ─────────────────────────────────────────────────────────────────────────────
# B) The ZeroClaw agent / SOP layer — NOT configured here
# ─────────────────────────────────────────────────────────────────────────────
#
# This file (.env) is for running `solpay` directly (scripts/demo.sh, verify.sh).
# The deployed ZeroClaw agent uses its OWN locked config (see agent/solpay.env.example,
# deployed to ~/.zeroclaw/solpay.env), because ZeroClaw clears a skill's environment
# and the skills source that file instead. See docs/CONFIGURATION.md.
#
# The agent's secrets are NOT env vars. Set them, encrypted at rest, with:
#   zeroclaw config set channels.whatsapp.default.access_token    --config-dir ~/.zeroclaw
#   zeroclaw config set channels.whatsapp.default.app_secret      --config-dir ~/.zeroclaw
#   zeroclaw config set channels.whatsapp.default.verify_token    --config-dir ~/.zeroclaw
#   zeroclaw config set channels.whatsapp.default.phone_number_id --config-dir ~/.zeroclaw
#   zeroclaw config set providers.models.openai.nlu.api_key       --config-dir ~/.zeroclaw
